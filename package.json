{
  "name": "windows-clone",
  "version": "0.1.0",
  "description": "React-powered Windows clone with GitHub persistence",
  "private": true,
  "workspaces": [
    "packages/frontend",
    "packages/backend",
    "packages/app-runtime"
  ],
  "scripts": {
    "dev": "npm run --workspace=packages/backend dev & npm run --workspace=packages/frontend dev",
    "build": "npm run --workspaces build",
    "test": "npm run --workspaces test",
    "type-check": "npm run --workspaces type-check"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
